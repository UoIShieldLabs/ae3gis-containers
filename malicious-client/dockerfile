# Dockerfile for malicious client
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install basic Ubuntu packages + penetration testing tools
RUN apt-get update && apt-get install -y \
    openssh-server \
    rsyslog \
    net-tools \
    iproute2 \
    iputils-ping \
    tcpdump \
    vim \
    nano \
    curl \
    wget \
    procps \
    nmap \
    netcat-openbsd \
    openssh-client \
    sshpass \
    smbclient \
    hydra \
    john \
    isc-dhcp-client \
    && rm -rf /var/lib/apt/lists/*

# SSH setup: root password + allow root/password login
RUN mkdir /var/run/sshd && \
    echo 'root:pass' | chpasswd && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?UsePAM.*/UsePAM no/' /etc/ssh/sshd_config

# The attacker's staged ICS toolkit (used by the Industroyer case-study tutorial):
# a loud, explainable IEC-104 payload and a symbolic data wiper. Harmless by design
# (see each file's header); carried here as the adversary/C2's authored tooling and
# dropped onto the engineering workstation / HMI during the attack.
COPY ics/ /opt/ics/
RUN chmod +x /opt/ics/industroyer104.py /opt/ics/ics-wiper.sh && \
    chmod 600 /opt/ics/attacker_key

# Clean SSH client config: friendly lab host aliases + no host-key prompts, so the
# tutorial's commands read `ssh user@gateway` instead of a wall of -o flags.
RUN mkdir -p /etc/ssh/ssh_config.d && printf '%s\n' \
    'Host fileserver' '  HostName 10.0.5.30' \
    'Host gateway'    '  HostName 10.0.4.20' \
    'Host historian'  '  HostName 10.0.4.30' \
    'Host ew'         '  HostName 10.0.3.15' \
    'Host rtu'        '  HostName 10.0.3.50' \
    'Host *' '  StrictHostKeyChecking no' '  UserKnownHostsFile /dev/null' '  LogLevel ERROR' \
    > /etc/ssh/ssh_config.d/99-lab.conf

# Expose SSH port
EXPOSE 22

# Start services: rsyslog and sshd
CMD ["sh", "-c", "rsyslogd && exec /usr/sbin/sshd -D"]

# AE3GIS image metadata (see image-standard.md)
LABEL org.opencontainers.image.title="Attack toolkit" \
      org.opencontainers.image.description="Ubuntu 24.04 attack toolkit: nmap, hydra, john, netcat, smbclient, ssh/sshpass, plus a staged IEC-104 payload and symbolic wiper in /opt/ics (Industroyer case study)." \
      io.ae3gis.schema="1" \
      io.ae3gis.type="attacker" \
      io.ae3gis.default="true"
