FROM ubuntu:16.04

ENV DEBIAN_FRONTEND=noninteractive

# Enable source repos, install build-deps + runtime tools + CA certs
RUN sed -i 's|^# deb-src|deb-src|' /etc/apt/sources.list && \
    apt-get update && \
    apt-get build-dep -y samba && \
    apt-get install -y --no-install-recommends \
      build-essential \
      python \
      ca-certificates \
      wget \
      git \
      openssh-server \
      openssh-client \
      sshpass \
      rsyslog \
      net-tools \
      iproute2 \
      iputils-ping \
      tcpdump \
      vim \
      nano \
      curl \
      wget \
      procps && \
    ln -sf /usr/bin/python2 /usr/bin/python && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# SSH setup: root password + allow root/password login
RUN mkdir /var/run/sshd && \
    echo 'root:pass' | chpasswd && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?UsePAM.*/UsePAM no/' /etc/ssh/sshd_config

# Download, compile & install vulnerable Samba 4.5.9
WORKDIR /opt
RUN wget https://download.samba.org/pub/samba/stable/samba-4.5.9.tar.gz && \
    tar xzf samba-4.5.9.tar.gz && \
    cd samba-4.5.9 && \
    ./configure && \
    make -j"$(nproc)" && \
    make install && \
    cd .. && rm -rf samba-4.5.9*

# Put Samba binaries in PATH
ENV PATH="/usr/local/samba/sbin:/usr/local/samba/bin:${PATH}"

# NOTE: Not requrired for installing on VM ---------------------------
# Make smbd/smbclient visible on all shells 
RUN ln -s /usr/local/samba/sbin/smbd    /usr/local/sbin/ && \
    ln -s /usr/local/samba/bin/smbclient /usr/local/bin/
# Export the Samba paths in a login-profile
RUN printf 'export PATH=/usr/local/samba/bin:/usr/local/samba/sbin:$PATH\n' \
    > /etc/profile.d/samba.sh && \
    chmod +x /etc/profile.d/samba.sh
# ---------------------------------------------------


# Copy minimal smb.conf
RUN mkdir -p /usr/local/samba/etc
COPY smb.conf /usr/local/samba/etc/smb.conf

# Planted (lab-only): the nightly file-transfer job's config, holding the sanctioned
# file-transfer service-account credential for the DMZ gateway. An intruder who lands
# on the fileserver reuses it over the sanctioned SFTP channel to cross into the DMZ.
RUN mkdir -p /etc/filetransfer
COPY push.conf /etc/filetransfer/push.conf
RUN chmod 644 /etc/filetransfer/push.conf

# B3 accounts + clean ssh (placed after the Samba build to keep its cache): HARDEN
# the root SSH password so a default-credential spray fails, add the `ftops` account
# with a strong non-default password (so the intended way in is the SMB key-drop into
# its home, not a guessed password), enable pubkey auth, and install the lab ssh config.
RUN echo 'root:f1l3S3rv!' | chpasswd && \
    useradd -m -s /bin/bash ftops && echo 'ftops:F!le0ps#2024' | chpasswd && \
    sed -i 's/^#\?PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config && \
    printf '%s\n' 'Host gateway' '  HostName 10.0.4.20' 'Host historian' '  HostName 10.0.4.30' \
      'Host ew' '  HostName 10.0.3.15' 'Host rtu' '  HostName 10.0.3.50' \
      'Host *' '  StrictHostKeyChecking no' '  UserKnownHostsFile /dev/null' '  LogLevel ERROR' \
      >> /etc/ssh/ssh_config

# Expose SSH + SMB ports
EXPOSE 22 139 445

# Start sshd, rsyslog, then Samba in one command
CMD ["/bin/bash","-c", "\
    /usr/sbin/sshd && \
    service rsyslog start && \
    exec /usr/local/samba/sbin/smbd -F --no-process-group\
"]

# AE3GIS image metadata (see image-standard.md)
LABEL org.opencontainers.image.title="Samba 4.5.9 (vulnerable)" \
      org.opencontainers.image.description="Samba 4.5.9 (from source, Ubuntu 16.04) with a guest-writable home-dir share (SMB key-drop vector), hardened root SSH, an ftops key-login account, and a planted file-transfer service credential (Industroyer B3)." \
      io.ae3gis.schema="1" \
      io.ae3gis.type="file-server" \
      io.ae3gis.stability="experimental"
