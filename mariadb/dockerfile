# MariaDB datastore + OT client libs — the lab's dual-homed historian/pivot.
# Named for the software (MariaDB); its lab role is in the AE3GIS metadata below.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Common baseline + SSH, MariaDB, OT recon tools, and Python for the client libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    rsyslog \
    iproute2 \
    iputils-ping \
    net-tools \
    tcpdump \
    curl \
    wget \
    vim \
    nano \
    procps \
    ca-certificates \
    mariadb-server \
    nmap \
    netcat-openbsd \
    openssh-client \
    sshpass \
    python3 \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# OT client libraries in a venv (Ubuntu 24.04 blocks system-wide pip, PEP 668).
# pymodbus (Scenario A) and c104 / IEC-104 (Scenario B) so one image fits either topology.
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir pymodbus c104
ENV PATH="/opt/venv/bin:$PATH"

# A one-word breaker control tool (status|open|close) over IEC-104, so a shell
# on this pivot can drive the RTU without a script.
COPY breaker /usr/local/bin/breaker
RUN chmod +x /usr/local/bin/breaker

# Listen on all interfaces so the DMZ file-transfer broker (gateway) can push
# reports into the historian DB - and so an intruder on the gateway can reach it.
RUN sed -ri 's/^#?\s*bind-address\s*=.*/bind-address = 0.0.0.0/' \
    /etc/mysql/mariadb.conf.d/50-server.cnf

# Historian DB seed (telemetry + a planted ot_credentials table + the reporting
# account). Applied on start; see historian-seed.sql.
COPY historian-seed.sql /opt/historian-seed.sql

# The OT data-collector config (benign telemetry feed settings). The scenario's
# planted secrets are the ot_credentials DB table and the OT key next to it.
RUN mkdir -p /etc/ot-collector
COPY collector.conf /etc/ot-collector/collector.conf
RUN chmod 644 /etc/ot-collector/collector.conf

# LAB-ONLY planted OT engineering SSH private key, kept in the historian's OT
# integration directory so the (non-root) maintenance account can read it. The
# engineering workstation trusts the matching public key, so whoever loots this key
# owns the EW. A deliberately-placed throwaway lab secret, never used outside this lab.
COPY ot_engineering_key /etc/ot-collector/ot_engineering_key
RUN chmod 644 /etc/ot-collector/ot_engineering_key

# The attacker's staged ICS toolkit, carried on the historian so the final Stage-1
# hop can "drop the payload" onto the engineering workstation. Harmless by design
# (see each file's header).
COPY ics/ /opt/ics/
RUN chmod +x /opt/ics/industroyer104.py /opt/ics/ics-wiper.sh

# SSH setup: root login, plus the historian's `histadmin` MAINTENANCE account
# (distinct credential, also stored in the ot_credentials table the intruder dumps).
RUN mkdir /var/run/sshd && \
    echo 'root:pass' | chpasswd && \
    useradd -m -s /bin/bash histadmin && echo 'histadmin:H1st0r!an' | chpasswd && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?UsePAM.*/UsePAM no/' /etc/ssh/sshd_config && \
    mkdir -p /etc/ssh/ssh_config.d && printf '%s\n' \
      'Host ew' '  HostName 10.0.3.15' 'Host rtu' '  HostName 10.0.3.50' \
      'Host *' '  StrictHostKeyChecking no' '  UserKnownHostsFile /dev/null' '  LogLevel ERROR' \
      > /etc/ssh/ssh_config.d/99-lab.conf

# This node is a pivot, not a router: IP forwarding is left off by design.

EXPOSE 22 3306

# Start logging, SSH, and MariaDB, seed the historian DB once it is up, then stay
# in the foreground. In Kathará the real startup is driven from the topology layer,
# so this only needs to stay up.
CMD ["sh", "-c", "rsyslogd; service ssh start; service mariadb start; i=0; until mysql -e 'SELECT 1' >/dev/null 2>&1 || [ $i -ge 30 ]; do i=$((i+1)); sleep 1; done; mysql < /opt/historian-seed.sql 2>/tmp/seed.err || true; exec sleep infinity"]

# AE3GIS image metadata (see image-standard.md)
LABEL org.opencontainers.image.title="MariaDB" \
      org.opencontainers.image.description="Ubuntu 24.04 + MariaDB historian with pymodbus and c104 (IEC-104) client libs; seeds a telemetry DB with a planted ot_credentials table and a lootable OT SSH key (Industroyer case study). SSH root/pass." \
      io.ae3gis.schema="1" \
      io.ae3gis.type="database-server" \
      io.ae3gis.stability="experimental"
